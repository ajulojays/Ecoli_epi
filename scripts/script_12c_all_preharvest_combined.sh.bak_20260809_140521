#!/usr/bin/env bash

# ============================================================
# script_12c_all_preharvest_combined.sh
#
# Production pangenome + core-genome phylogeny pipeline
# for all non-dairy cattle pre-harvest genomes:
#   Beef + Cattle-unspecified, Pre-harvest only
#
# Expected target count from 02E:
#   Beef pre-harvest                 = 118
#   Cattle-unspecified pre-harvest   = 586
#   Total                            = 704
# ============================================================

set -euo pipefail

# ==========================================
# 1. GLOBAL PATHS & SETTINGS
# ==========================================

BASE_DIR="/home/samuelajulo/epi/Ecoli_epi"
METADATA_CSV="/home/samuelajulo/epi/data6a.csv"
BAKTA_DIR="${BASE_DIR}/results/bakta"
RESULTS_DIR="${BASE_DIR}/results/12c_all_preharvest_combined"

PANAROO_ENV="panaroo_env"
IQTREE_ENV="iqtree_env"

THREADS=128
CORE_THRESHOLD=0.95
EXPECTED_METADATA_COUNT=704

# Use strict by default for QC-filtered public assemblies.
# To override:
#   PANAROO_CLEAN_MODE=moderate bash script_12c_all_preharvest_combined.sh
PANAROO_CLEAN_MODE="${PANAROO_CLEAN_MODE:-strict}"

TARGET_METADATA_CSV="${RESULTS_DIR}/target_metadata_beef_cattle_unspecified_preharvest.csv"
TARGET_SAMPLE_LIST="${RESULTS_DIR}/target_sample_ids.txt"
GFF_LIST_FILE="${RESULTS_DIR}/panaroo_gff_list.txt"
GFF_MANIFEST="${RESULTS_DIR}/panaroo_gff_mapping_manifest.csv"

PANAROO_OUT="${RESULTS_DIR}/panaroo"
IQTREE_OUT="${RESULTS_DIR}/iqtree"
LOG_DIR="${RESULTS_DIR}/logs"

# ==========================================
# 2. CONDA INITIALIZATION
# ==========================================

if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
elif [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif [ -f "$HOME/anaconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/anaconda3/etc/profile.d/conda.sh"
else
    source "$(conda info --base)/etc/profile.d/conda.sh" 2>/dev/null || true
fi

# ==========================================
# 3. CLEAN START
# ==========================================

echo "=========================================================="
echo " 12C: All non-dairy cattle pre-harvest pangenome pipeline"
echo "=========================================================="
echo "[INFO] Base directory:       ${BASE_DIR}"
echo "[INFO] Metadata:             ${METADATA_CSV}"
echo "[INFO] Bakta directory:      ${BAKTA_DIR}"
echo "[INFO] Results directory:    ${RESULTS_DIR}"
echo "[INFO] Panaroo clean mode:   ${PANAROO_CLEAN_MODE}"
echo "[INFO] Core threshold:       ${CORE_THRESHOLD}"
echo "[INFO] Threads:              ${THREADS}"
echo ""

rm -rf "$RESULTS_DIR"
mkdir -p "$RESULTS_DIR" "$PANAROO_OUT" "$IQTREE_OUT" "$LOG_DIR"

# ==========================================
# 4. PRE-FLIGHT CHECKS
# ==========================================

echo "----------------------------------------------------------"
echo " Pre-flight checks"
echo "----------------------------------------------------------"

ERRORS=0

if [ ! -f "$METADATA_CSV" ]; then
    echo "[ERROR] Metadata file not found: $METADATA_CSV"
    ERRORS=$((ERRORS + 1))
else
    echo "[OK] Metadata file found."
fi

if [ ! -d "$BAKTA_DIR" ]; then
    echo "[ERROR] Bakta directory not found: $BAKTA_DIR"
    ERRORS=$((ERRORS + 1))
else
    GFF_TOTAL=$(find "$BAKTA_DIR" -type f \( -name "*.gff3" -o -name "*.gff" \) | wc -l || echo 0)
    echo "[OK] Bakta directory found with ${GFF_TOTAL} GFF/GFF3 files."
    if [ "$GFF_TOTAL" -eq 0 ]; then
        echo "[ERROR] No GFF/GFF3 files found under: $BAKTA_DIR"
        ERRORS=$((ERRORS + 1))
    fi
fi

if ! conda env list | awk '{print $1}' | grep -qx "$PANAROO_ENV"; then
    echo "[ERROR] Conda environment not found: $PANAROO_ENV"
    ERRORS=$((ERRORS + 1))
else
    echo "[OK] Conda environment exists: $PANAROO_ENV"

    if ! conda run -n "$PANAROO_ENV" which panaroo >/dev/null 2>&1; then
        echo "[ERROR] panaroo not executable inside $PANAROO_ENV"
        ERRORS=$((ERRORS + 1))
    else
        echo "[OK] panaroo executable verified."
    fi

    if ! conda run -n "$PANAROO_ENV" which mafft >/dev/null 2>&1; then
        echo "[ERROR] mafft not executable inside $PANAROO_ENV"
        ERRORS=$((ERRORS + 1))
    else
        echo "[OK] mafft executable verified."
    fi
fi

if ! conda env list | awk '{print $1}' | grep -qx "$IQTREE_ENV"; then
    echo "[ERROR] Conda environment not found: $IQTREE_ENV"
    ERRORS=$((ERRORS + 1))
else
    echo "[OK] Conda environment exists: $IQTREE_ENV"

    if ! conda run -n "$IQTREE_ENV" bash -c "which iqtree || which iqtree2" >/dev/null 2>&1; then
        echo "[ERROR] iqtree/iqtree2 not executable inside $IQTREE_ENV"
        ERRORS=$((ERRORS + 1))
    else
        echo "[OK] iqtree/iqtree2 executable verified."
    fi
fi

if [ "$ERRORS" -gt 0 ]; then
    echo ""
    echo "[FATAL] Pre-flight checks failed."
    exit 1
fi

echo "[SUCCESS] Pre-flight checks passed."
echo ""

# ==========================================
# 5. EXTRACT EXACT TARGET METADATA AND MAP GFFS
# ==========================================

echo "----------------------------------------------------------"
echo " Extracting Beef + Cattle-unspecified Pre-harvest genomes"
echo "----------------------------------------------------------"

python3 - <<PY
import os
import re
import sys
import pandas as pd
from pathlib import Path

metadata_csv = "$METADATA_CSV"
bakta_dir = Path("$BAKTA_DIR")
target_metadata_csv = "$TARGET_METADATA_CSV"
target_sample_list = "$TARGET_SAMPLE_LIST"
gff_list_file = "$GFF_LIST_FILE"
gff_manifest = "$GFF_MANIFEST"
expected_count = int("$EXPECTED_METADATA_COUNT")

df = pd.read_csv(metadata_csv)

required = ["Production_system", "Supply_chain_stage"]
missing = [c for c in required if c not in df.columns]
if missing:
    raise SystemExit(f"[ERROR] Missing required metadata columns: {missing}")

id_col = None
for candidate in ["Assembly", "Isolate", "Strain", "Sample", "sample"]:
    if candidate in df.columns:
        id_col = candidate
        break

if id_col is None:
    id_col = df.columns[0]

def norm_text(x):
    if pd.isna(x):
        return ""
    return str(x).strip().lower()

def classify_stage(x):
    s = norm_text(x)
    if "post" in s:
        return "Post-harvest"
    if "peri" in s or "harvest-interface" in s or "interface" in s:
        return "Peri-harvest"
    return "Pre-harvest"

def classify_prod(x):
    s = norm_text(x)
    if "beef" in s:
        return "Beef"
    if "dairy" in s:
        return "Dairy"
    if "cattle" in s or "unspecified" in s:
        return "Cattle-unspecified"
    return "Cattle-unspecified"

def normalize_id(x):
    x = str(x).strip()
    x = os.path.basename(x)
    x = re.sub(r"\.gz$", "", x)
    x = re.sub(r"\.(fasta|fna|fa|gff|gff3|txt|tsv|csv)$", "", x)
    m = re.search(r"GC[AF]_[0-9]+\.[0-9]+", x)
    return m.group(0) if m else x

df["stage_12c"] = df["Supply_chain_stage"].apply(classify_stage)
df["prod_12c"] = df["Production_system"].apply(classify_prod)
df["sample_id_12c"] = df[id_col].apply(lambda x: str(x).strip())
df["sample_key_12c"] = df["sample_id_12c"].apply(normalize_id)

subset = df[
    (df["stage_12c"] == "Pre-harvest") &
    (df["prod_12c"].isin(["Beef", "Cattle-unspecified"]))
].copy()

subset = subset.drop_duplicates(subset=["sample_key_12c"])

subset.to_csv(target_metadata_csv, index=False)

with open(target_sample_list, "w") as handle:
    for sid in subset["sample_key_12c"].dropna():
        handle.write(str(sid).strip() + "\n")

target_count = len(subset)
print(f"[INFO] Target metadata count: {target_count}")
print(f"[INFO] ID column used: {id_col}")

if target_count != expected_count:
    print(f"[ERROR] Expected {expected_count} target genomes, but found {target_count}.")
    print("[ERROR] Review Production_system and Supply_chain_stage classification before running Panaroo.")
    sys.exit(1)

# Build robust GFF index
gff_index = {}

for p in bakta_dir.rglob("*"):
    if not p.is_file():
        continue
    if p.suffix.lower() not in [".gff", ".gff3"]:
        continue

    keys = set()
    keys.add(normalize_id(p.name))
    keys.add(normalize_id(p.stem))
    keys.add(normalize_id(p.parent.name))

    m = re.search(r"GC[AF]_[0-9]+\.[0-9]+", str(p))
    if m:
        keys.add(m.group(0))

    for k in keys:
        if k and k not in gff_index:
            gff_index[k] = str(p)

mapped = []
manifest_rows = []

for _, row in subset.iterrows():
    sid = row["sample_id_12c"]
    key = row["sample_key_12c"]

    gff_path = gff_index.get(key)

    if gff_path:
        mapped.append(gff_path)
        manifest_rows.append({
            "sample_id": sid,
            "sample_key": key,
            "gff_path": gff_path,
            "mapping_status": "mapped"
        })
    else:
        manifest_rows.append({
            "sample_id": sid,
            "sample_key": key,
            "gff_path": "",
            "mapping_status": "missing_gff"
        })

pd.DataFrame(manifest_rows).to_csv(gff_manifest, index=False)

with open(gff_list_file, "w") as handle:
    for p in mapped:
        handle.write(p + "\n")

mapped_count = len(mapped)
print(f"[INFO] Mapped GFF count: {mapped_count} / {target_count}")

if mapped_count != target_count:
    print("[ERROR] Not all target genomes mapped to Bakta GFF files.")
    print(f"[ERROR] See manifest: {gff_manifest}")
    sys.exit(1)

if len(set(mapped)) != mapped_count:
    print("[ERROR] Duplicate GFF paths detected after mapping.")
    print(f"[ERROR] See manifest: {gff_manifest}")
    sys.exit(1)

print("[SUCCESS] Metadata extraction and GFF mapping completed.")
PY

echo ""
echo "[INFO] Target metadata:"
ls -lh "$TARGET_METADATA_CSV"

echo "[INFO] GFF list:"
ls -lh "$GFF_LIST_FILE"

echo "[INFO] GFF manifest:"
ls -lh "$GFF_MANIFEST"

echo ""
echo "[INFO] First 5 GFF paths:"
head -n 5 "$GFF_LIST_FILE"

MAPPED_GFF_COUNT=$(wc -l < "$GFF_LIST_FILE" | tr -d ' ')
echo ""
echo "[INFO] Final mapped GFF count: ${MAPPED_GFF_COUNT}"

if [ "$MAPPED_GFF_COUNT" -ne "$EXPECTED_METADATA_COUNT" ]; then
    echo "[FATAL] Expected ${EXPECTED_METADATA_COUNT} GFF files but got ${MAPPED_GFF_COUNT}."
    exit 1
fi

# ==========================================
# 6. PANAROO CORE ALIGNMENT
# ==========================================

echo ""
echo "----------------------------------------------------------"
echo " Running Panaroo core genome alignment"
echo "----------------------------------------------------------"

ulimit -n 65535 || true

if [ -d /dev/shm ] && [ -w /dev/shm ]; then
    TMP_PARENT="/dev/shm"
else
    TMP_PARENT="${RESULTS_DIR}/tmp"
fi

PANAROO_TMP="${TMP_PARENT}/panaroo_12c_${USER}_$$"
mkdir -p "$PANAROO_TMP"
export TMPDIR="$PANAROO_TMP"

echo "[INFO] Temporary directory: $TMPDIR"

mapfile -t GFF_ARRAY < "$GFF_LIST_FILE"

echo "[INFO] Number of GFF arguments passed to Panaroo: ${#GFF_ARRAY[@]}"

if [ "${#GFF_ARRAY[@]}" -ne "$EXPECTED_METADATA_COUNT" ]; then
    echo "[FATAL] GFF array count does not match expected count."
    exit 1
fi

conda activate "$PANAROO_ENV"

echo "[INFO] Panaroo version:"
panaroo --version || true

echo "[INFO] Running Panaroo with clean mode: ${PANAROO_CLEAN_MODE}"

panaroo \
    -i "${GFF_ARRAY[@]}" \
    -o "$PANAROO_OUT" \
    --clean-mode "$PANAROO_CLEAN_MODE" \
    --remove-invalid-genes \
    -a core \
    --aligner mafft \
    --core_threshold "$CORE_THRESHOLD" \
    -t "$THREADS" \
    2>&1 | tee "${LOG_DIR}/panaroo_run.log"

if [ -s "${PANAROO_OUT}/core_gene_alignment_filtered.aln" ]; then
    CORE_ALIGNMENT="${PANAROO_OUT}/core_gene_alignment_filtered.aln"
elif [ -s "${PANAROO_OUT}/core_gene_alignment.aln" ]; then
    CORE_ALIGNMENT="${PANAROO_OUT}/core_gene_alignment.aln"
else
    echo "[FATAL] Panaroo did not produce a core alignment."
    exit 1
fi

echo "[SUCCESS] Core alignment produced:"
echo "$CORE_ALIGNMENT"

ls -lh "$CORE_ALIGNMENT"

# ==========================================
# 7. IQ-TREE PHYLOGENY
# ==========================================

echo ""
echo "----------------------------------------------------------"
echo " Running IQ-TREE"
echo "----------------------------------------------------------"

conda activate "$IQTREE_ENV"

IQTREE_CMD="iqtree"
if ! command -v iqtree >/dev/null 2>&1 && command -v iqtree2 >/dev/null 2>&1; then
    IQTREE_CMD="iqtree2"
fi

echo "[INFO] IQ-TREE command: $IQTREE_CMD"
echo "[INFO] IQ-TREE version:"
$IQTREE_CMD --version || true

cd "$IQTREE_OUT"

$IQTREE_CMD \
    -s "$CORE_ALIGNMENT" \
    -m MFP \
    -bb 1000 \
    -nt AUTO \
    -ntmax "$THREADS" \
    -pre "all_preharvest_704_core_phylo" \
    2>&1 | tee "${LOG_DIR}/iqtree_run.log"

# ==========================================
# 8. FINAL CHECKS
# ==========================================

TREEFILE="${IQTREE_OUT}/all_preharvest_704_core_phylo.treefile"

echo ""
echo "=========================================================="
echo " 12C pipeline completed"
echo "=========================================================="
echo "[RESULTS] ${RESULTS_DIR}"
echo "[PANAROO] ${PANAROO_OUT}"
echo "[IQTREE]  ${IQTREE_OUT}"

if [ -s "$TREEFILE" ]; then
    echo "[SUCCESS] Treefile generated:"
    ls -lh "$TREEFILE"
else
    echo "[WARN] Expected treefile not found:"
    echo "$TREEFILE"
fi

echo ""
echo "[INFO] Key outputs:"
find "$RESULTS_DIR" -maxdepth 3 -type f \( -name "*.csv" -o -name "*.txt" -o -name "*.aln" -o -name "*.treefile" -o -name "*.log" \) | sort

echo ""
echo "[DONE] All non-dairy cattle pre-harvest combined analysis finished."
